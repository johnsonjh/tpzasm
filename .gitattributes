# Object-output golden fixtures are byte-exact: the binary .rel form is raw
# bytes, and the ASCII .hex form embeds CR/LF record separators that must be
# preserved verbatim for tests/test_obj.sh.  Treat them as binary so neither a
# checkout nor a format-patch/am round-trip ever normalizes their line endings.
tests/golden/*.rel binary
tests/golden/*.hex binary

