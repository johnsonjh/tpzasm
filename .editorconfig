# EditorConfig: https://editorconfig.org/
# TPZASM: TDL ZASM / PSA PASM compatible assembler - .editorconfig
# Copyright (c) 2026 Jeffrey H. Johnson <johnsonjh.dev@gmail.com>
# SPDX-License-Identifier: MIT-0
# scspell-id: e76fa97e-6343-11f1-8c5c-246e96298730

root = true

################################################################################

[*.{c,h,sh}]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

################################################################################

[.gitignore]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

################################################################################

[.gitattributes]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

################################################################################

[*.py]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = true

################################################################################

[*.asm]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = true

################################################################################

# SARGON is a ported real-world program kept verbatim as a regression test; it
# is space-indented (not the TDL tab convention), so override the [*.asm] rule.
[tests/sargon.asm]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = true

################################################################################

# The TDL ZAPPLE 2-K monitor (1976) and ZAP 1-K monitor (1977) are real-world
# sources kept verbatim as differential-test fixtures: the listing reproduces
# the source text exactly, so their original trailing whitespace must NOT be
# trimmed (both are tab-indented).
[tests/{zapple,zap1k}.asm]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = false

################################################################################

# The TDL Z80 disassembler (1979) is a real-world source kept verbatim as a
# differential-test fixture; it is mostly space-indented with a few tab lines,
# so leave the indentation style unchecked rather than rewrite the source.
[tests/dis.asm]
charset = utf-8
end_of_line = lf
indent_style = unset
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = true

################################################################################

# Real-world TDL sources kept verbatim as differential-test fixtures: the GO
# command (Memory Merchants, CP/M Users' Group) and the Alloy Engineering
# ITS100/TIP linker (1979).  Both are tab-indented; the listing reproduces the
# source text exactly, so their original trailing whitespace must NOT be
# trimmed (ittl carries significant trailing blanks inside comments).
[tests/{go,ittl}.asm]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = false

################################################################################

# Real-world Alloy Engineering TDL utilities kept verbatim (the cipher- and
# mag-tape utilities, 1980-1981).  They are mostly tab-indented with a few
# space-aligned lines, so leave the indentation style unchecked, and preserve
# their original trailing whitespace (it is part of the verbatim listing).
[tests/{atu4,mtu4}.asm]
charset = utf-8
end_of_line = lf
indent_style = unset
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = false

################################################################################

# The real-world DMS/3, DMS/4 HiNet / CP/M BIOS (Alloy / DMS, ~9300 lines) kept
# verbatim as a differential-test fixture.  It mixes tab and space indentation,
# has some comment/table lines past 88 columns, and the listing reproduces the
# source text exactly, so leave the indent style and line length unchecked and
# do not trim its trailing whitespace.
[tests/bios.asm]
charset = utf-8
end_of_line = lf
indent_style = unset
insert_final_newline = true
max_line_length = unset
trim_trailing_whitespace = false

################################################################################

# The real-world TAPELIB cassette-tape library manager (S. J. Singer, 1977) kept
# verbatim as a differential-test fixture: it is tab-indented and the listing
# reproduces the source text exactly, so its original trailing whitespace must
# NOT be trimmed.
[tests/tapelib.asm]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = false

################################################################################

# The ZAPPLE 2-K monitor V2.R (Computer Design Labs / TDL, (c) 1978, re-keyed by
# Herb Johnson 2019 from a V1.05R 1979 printout) kept verbatim as a differential-
# test fixture: a .PABS/.PHEX/.XLINK absolute build, mostly tab-indented with a
# few space-aligned lines (so leave the indent style unchecked), and its original
# trailing whitespace must NOT be trimmed.  It even retains a stray ^A control
# byte in one comment (a transcription artifact) which the assembler drops from
# the listing; keep it verbatim.
[tests/ssmon.asm]
charset = utf-8
end_of_line = lf
indent_style = unset
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = false

################################################################################

# The Plu*Perfect Systems Universal High-BIOS for the Advent Turbo ROM (Kaypro,
# (c) 1985) kept verbatim as a regression fixture: a .PABS/.PHEX/.XLINK absolute
# build that exercises a recursive memory-fill macro (PADBYT), TDL indexed
# addressing `(disp)(X)', and an unknown directive (`.SETWID') ahead of the first
# .LOC.  Tab-indented; its original trailing whitespace must NOT be trimmed.
# (The recovered file's post-`.end' ^Z and disk-slack tail are dropped; the
# source ends at `.end'.)
[tests/turbobs.asm]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = false

################################################################################

[*akefile*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

################################################################################

[README.md]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

################################################################################
