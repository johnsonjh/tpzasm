# EditorConfig: https://editorconfig.org/
# TPZASM: TDL ZASM / PSA PASM compatible assembler - .editorconfig
# Copyright (c) 2026 Jeffrey H. Johnson <johnsonjh.dev@gmail.com>
# SPDX-License-Identifier: MIT-0
# scspell-id: e76fa97e-6343-11f1-8c5c-246e96298730

root = true

################################################################################

[*.{c,sh}]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

################################################################################

[.gitignore]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

################################################################################

[.gitattributes]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

################################################################################

[*.py]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = true

################################################################################

[*.asm]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = true

################################################################################

# SARGON is a ported real-world program kept verbatim as a regression test; it
# is space-indented (not the TDL tab convention), so override the [*.asm] rule.
[tests/sargon.asm]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = true

################################################################################

# The TDL ZAPPLE 2-K monitor (1976) is a real-world source kept verbatim as a
# differential-test fixture: the listing reproduces the source text exactly, so
# its original trailing whitespace must NOT be trimmed (it is tab-indented).
[tests/zapple.asm]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = false

################################################################################

# The TDL Z80 disassembler (1979) is a real-world source kept verbatim as a
# differential-test fixture; it is mostly space-indented with a few tab lines,
# so leave the indentation style unchecked rather than rewrite the source.
[tests/dis.asm]
charset = utf-8
end_of_line = lf
indent_style = unset
insert_final_newline = true
max_line_length = 88
trim_trailing_whitespace = true

################################################################################

[*akefile*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

################################################################################

[README.md]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

################################################################################
