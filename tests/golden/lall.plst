                                 .RADIX  16
                         ;
                         ;       .LALL (list-all) does NOT flatten a macro expa
                         nsion: every nesting
                         ;       level lists its own call line (invocation + bo
                         dy-open '[') and its
                         ;       body-close ']', and every body line lists with
                          a '+' marker -- EXCEPT
                         ;       a ';;' double-semi comment, whose text the ori
                         ginals suppress (it
                         ;       lists as a blank '+' line).  A single ';' comm
                         ent lists verbatim.
                         ;
                                 .DEFINE INNER[] = [
                                 NOP
                                 ]
                                 .DEFINE OUTER[] = [
                         ;;      this double-semi comment lists BLANK
                                 INNER
                                 RET
                                 ]
                                 .DEFINE A[] = [
                                 NOP
                                 ]
                                 .DEFINE B[] = [
                                 A
                         ;       this single-semi comment lists verbatim
                                 INR     C
                                 ]
                                 .DEFINE C3[] = [
                                 B
                                 RET
                                 ]
   0100                          .LOC    100H
                                 OUTER                   ;two-level nest + a ';
                         ;' comment[
                        +
                        +        INNER[
   0100    00           +        NOP
                        +        ]
   0101    C9           +        RET
                        +        ]
                                 C3                      ;three-level nest + a
                         ';' comment[
                        +        B[
                        +        A[
   0102    00           +        NOP
                        +        ]
                        +;       this single-semi comment lists verbatim
   0103    0C           +        INR     C
                        +        ]
   0104    C9           +        RET
                        +        ]
                                 .END
+++++ Symbol Table +++++
.BLNK. 0000:03 X    .DATA. 0000"   X    .PROG. 0000'   X
